{
  "name": "totp-generator",
  "version": "2.0.1",
  "description": "Generate TOTP tokens from key",
  "license": "MIT",
  "author": "Magnus Bellstrand",
  "homepage": "https://github.com/bellstrand/totp-generator",
  "bugs": {
    "url": "https://github.com/bellstrand/totp-generator/issues"
  },
  "keywords": [
    "totp",
    "time-based one-time password",
    "generator",
    "password",
    "auth",
    "authentication",
    "google authenticator",
    "oath",
    "2-factor",
    "two-factor"
  ],
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bellstrand/totp-generator.git"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "check": "biome check",
    "build": "rm -rf lib/* && bun run build:cjs && bun run build:esm && ./build-after.sh",
    "build:cjs": "tsc -p tsconfig-cjs.json && terser lib/cjs/index.js -cmo lib/cjs/index.js --source-map \"content='lib/cjs/index.js.map',url='index.js.map'\"",
    "build:esm": "tsc -p tsconfig-esm.json && terser lib/esm/index.js -cmo lib/esm/index.js --source-map \"content='lib/esm/index.js.map',url='index.js.map'\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "terser": "^5.49.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "package.json",
    "lib",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "jssha": "^3.3.2"
  }
}
